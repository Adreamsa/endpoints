<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.teletubies</groupId>
	<artifactId>endpoints</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>endpoints</name>
	<description>Ejercicio: API de Cotizacion de Envios</description>

	<properties>
		<java.version>21</java.version>
		<openapi-generator-maven-plugin.version>7.25.0</openapi-generator-maven-plugin.version>
		<jackson-databind-nullable.version>0.2.6</jackson-databind-nullable.version>
		<springdoc.version>3.1.1</springdoc.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
			Lombok: genera codigo repetitivo en tiempo de compilacion (@RequiredArgsConstructor, @Slf4j...).
			optional=true porque solo se necesita al compilar; no es una dependencia de tu aplicacion
			en ejecucion y no debe propagarse a quien consuma este artefacto.
			IMPORTANTE: tu IDE necesita "annotation processing" habilitado o marcara errores falsos.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
			jackson-databind-nullable: la importa el codigo generado; sin ella no compila.
			springdoc: sirve Swagger UI en /swagger-ui/index.html

			NO declares io.swagger.core.v3:swagger-annotations con version fija: springdoc
			arrastra la suya, y fijarla rompe /v3/api-docs con NoSuchMethodError.
		-->
		<dependency>
			<groupId>org.openapitools</groupId>
			<artifactId>jackson-databind-nullable</artifactId>
			<version>${jackson-databind-nullable.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Slice @WebMvcTest: en Spring Boot 4 vive en su propio starter, ya no viene en spring-boot-starter-test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Lombok desaparece tras compilar: no tiene por que viajar dentro del jar -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!--
				Genera api/ (interfaces + controllers) y model/ desde open-api/openapi.yaml,
				en la fase generate-sources: `make build` ya regenera solo.

				NO edites lo generado: vive en target/ y se sobrescribe. Cambia el YAML.
			-->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>openapi</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/open-api/openapi.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.teletubies.endpoints.api</apiPackage>
							<modelPackage>com.teletubies.endpoints.model</modelPackage>
							<supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
							<configOptions>
									<!-- Genera una interfaz XxxApiDelegate que implementas tu, en vez
									     de un controller que tendrias que editar. -->
									<delegatePattern>true</delegatePattern>
									<!-- El nombre de la interfaz sale del `tags` de la operacion; sin
									     esto saldria de la ruta y todo seria ApiApiDelegate. -->
									<useTags>true</useTags>
								<useJakartaEe>true</useJakartaEe>
								<generateBuilders>true</generateBuilders>
							</configOptions>
							<typeMappings>
								<!-- Dinero y pesos con double pierden precision. -->
								<typeMapping>Double=java.math.BigDecimal</typeMapping>
							</typeMappings>
							<!--
								Un enum de enum.yaml se genera, salvo que lo mapees a una clase tuya.
								Mapeado, el contrato sigue documentando los valores pero la clase es
								tuya y puede llevar comportamiento (ver Moneda.java).

								Hacen falta las dos listas:
								  importMappings  el codigo generado importa TU clase
								  schemaMappings  ademas, no genera una clase propia
								Con solo la primera queda un enum huerfano en model/.

								TE TOCA A TI: `ZonaEjemplo` apunta a una clase de demostracion. Cuando
								definas tus zonas, escribe cotizacion/enums/Zona.java y reapunta sus
								dos lineas.
							-->
							<importMappings>
								<importMapping>ZonaEjemplo=com.teletubies.endpoints.ejemplo.enums.ZonaEjemplo</importMapping>
								<importMapping>Moneda=com.teletubies.endpoints.ejemplo.enums.Moneda</importMapping>
							</importMappings>
							<schemaMappings>
								<schemaMapping>ZonaEjemplo=com.teletubies.endpoints.ejemplo.enums.ZonaEjemplo</schemaMapping>
								<schemaMapping>Moneda=com.teletubies.endpoints.ejemplo.enums.Moneda</schemaMapping>
							</schemaMappings>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
