<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.teletubies</groupId>
	<artifactId>endpoints</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>endpoints</name>
	<description>Ejercicio: API de Cotizacion de Envios</description>

	<properties>
		<java.version>21</java.version>
		<openapi-generator-maven-plugin.version>7.25.0</openapi-generator-maven-plugin.version>
		<jackson-databind-nullable.version>0.2.6</jackson-databind-nullable.version>
		<springdoc.version>3.1.1</springdoc.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
			Lombok: genera codigo repetitivo en tiempo de compilacion (@RequiredArgsConstructor, @Slf4j...).
			optional=true porque solo se necesita al compilar; no es una dependencia de tu aplicacion
			en ejecucion y no debe propagarse a quien consuma este artefacto.
			IMPORTANTE: tu IDE necesita "annotation processing" habilitado o marcara errores falsos.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
			Lo que necesita el codigo que genera openapi-generator.

			jackson-databind-nullable: el generador lo importa en los modelos para poder
			distinguir "el campo vino como null" de "el campo no vino". Sin esta
			dependencia el codigo generado no compila.

			springdoc: publica el contrato de la aplicacion ya corriendo y sirve Swagger
			UI en http://localhost:8080/swagger-ui/index.html

			NOTA: no declares io.swagger.core.v3:swagger-annotations con una version fija.
			springdoc arrastra la que le corresponde; fijarla a mano rompe /v3/api-docs
			en tiempo de ejecucion con NoSuchMethodError.
		-->
		<dependency>
			<groupId>org.openapitools</groupId>
			<artifactId>jackson-databind-nullable</artifactId>
			<version>${jackson-databind-nullable.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Slice @WebMvcTest: en Spring Boot 4 vive en su propio starter, ya no viene en spring-boot-starter-test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Lombok desaparece tras compilar: no tiene por que viajar dentro del jar -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!--
				Genera, a partir de open-api/openapi.yaml y en cada compilacion:
				  target/generated-sources/openapi/.../api/    interfaces + controllers
				  target/generated-sources/openapi/.../model/  modelos de entrada y salida

				Corre en la fase generate-sources, o sea ANTES de compilar: `make build`
				ya regenera solo. `make openapi-generate` es para regenerar sin compilar.

				NO edites lo generado: vive en target/ y se sobrescribe en cada build.
				Lo que quieras cambiar, cambialo en el YAML.
			-->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>openapi</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/open-api/openapi.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.teletubies.endpoints.api</apiPackage>
							<modelPackage>com.teletubies.endpoints.model</modelPackage>
							<supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
							<configOptions>
								<!--
									delegatePattern: en vez de un controller que tienes que
									editar, genera una interfaz XxxApiDelegate que TU
									implementas. Asi el codigo generado se puede regenerar
									siempre sin pisar lo tuyo.
								-->
								<delegatePattern>true</delegatePattern>
								<!--
									useTags: el nombre de la interfaz sale del `tags` de la
									operacion. Sin esto saldria del primer segmento de la
									ruta, y con /api/v1/... todo se llamaria ApiApiDelegate.
								-->
								<useTags>true</useTags>
								<useJakartaEe>true</useJakartaEe>
								<generateBuilders>true</generateBuilders>
							</configOptions>
							<typeMappings>
								<!-- Dinero y pesos con double pierden precision. -->
								<typeMapping>Double=java.math.BigDecimal</typeMapping>
							</typeMappings>
							<!--
								Un enum de open-api/enum.yaml se puede dejar generado, o se
								puede mapear a una clase escrita a mano. Mapeado, el
								contrato sigue documentando los valores validos, pero la
								clase es tuya y puede llevar comportamiento: la descripcion
								legible, una tarifa, un metodo de busqueda.

								Hacen falta las DOS listas, y hacen cosas distintas:
								  importMappings  el codigo generado importa TU clase
								  schemaMappings  ademas, no genera una clase propia

								Con solo importMappings el resultado tambien compila, pero
								queda un enum huerfano en model/ que nadie usa y que
								aparece en el autocompletado del IDE junto al tuyo.

								=========================================================
								TE TOCA A TI

								`ZonaEjemplo` apunta hoy a una clase de DEMOSTRACION que
								vive en el paquete `ejemplo`. No son tus zonas: cuando
								definas las tuyas, renombra el schema en enum.yaml, escribe
								tu cotizacion/enums/Zona.java y cambia sus dos lineas de
								abajo para que apunten ahi.
								=========================================================

								Al borrar el paquete `ejemplo` se van las dos clases que
								estan mapeadas ahora mismo. Para entonces `Zona` ya debe
								apuntar a la tuya, y el mapeo de `Moneda` hay que quitarlo:
								si un mapeo apunta a una clase borrada, la build falla.
							-->
							<importMappings>
								<importMapping>ZonaEjemplo=com.teletubies.endpoints.ejemplo.enums.ZonaEjemplo</importMapping>
								<importMapping>Moneda=com.teletubies.endpoints.ejemplo.enums.Moneda</importMapping>
							</importMappings>
							<schemaMappings>
								<schemaMapping>ZonaEjemplo=com.teletubies.endpoints.ejemplo.enums.ZonaEjemplo</schemaMapping>
								<schemaMapping>Moneda=com.teletubies.endpoints.ejemplo.enums.Moneda</schemaMapping>
							</schemaMappings>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
